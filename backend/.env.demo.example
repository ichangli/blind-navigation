# The packaged demo generates demo.env automatically. This template is safe to share.
DATABASE_URL=sqlite:///./data/demo.db
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
UPLOAD_DIR=data/uploads
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,null

GEOSCENE_PORTAL_URL=https://your-domain/geoscene
GEOSCENE_PORTAL_WEBAPPS_URL=https://your-domain/geoscene/webapps
GEOSCENE_SERVER_URL=https://your-domain/server
GEOSCENE_BUILDING_LAYER_URL=https://your-domain/server/rest/services/Hosted/YourBuildings/SceneServer
GEOSCENE_ROUTE_MAPSERVER_URL=https://your-domain/server/rest/services/YourRoute/MapServer
GEOSCENE_ROUTE_NASERVER_URL=https://your-domain/server/rest/services/YourRoute/NAServer
GEOSCENE_ROAD_VISUAL_MAPSERVER_URL=https://your-domain/server/rest/services/YourRoadVisual/MapServer
GEOSCENE_ROAD_VISUAL_LAYER_ID=0
GEOSCENE_ROAD_LAYER_ID=6
GEOSCENE_ROUTE_LAYER_NAME=路径
GEOSCENE_ROUTE_IMPEDANCE=SafeMinutes
GEOSCENE_VERIFY_SSL=false

FUTIAN_BUILDINGS_GEOJSON=shenzhen_data/processed/buildings/futian_buildings_cityengine.geojson
FUTIAN_BUILDINGS_ROUTE=/data/buildings
CITY_NAME=深圳
DISTRICT_NAME=福田区
MAP_CENTER_LON=114.055
MAP_CENTER_LAT=22.535

AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
TIANDITU_KEY=
JWT_SECRET=replace-with-a-demo-only-random-value
