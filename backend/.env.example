APP_ENV=production
# Production: set a unique password (12+ characters) and JWT_SECRET (32+ characters).
ADMIN_PASSWORD=
# PostgreSQL，本机直接连接，不使用 Docker
DATABASE_URL=postgresql+psycopg2://postgres:your_password@127.0.0.1:5432/blind_path
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# GeoScene / ArcGIS Enterprise，本机已部署时按实际地址修改
GEOSCENE_PORTAL_URL=https://your-domain/geoscene
GEOSCENE_PORTAL_WEBAPPS_URL=https://your-domain/geoscene/webapps
GEOSCENE_PORTAL_USERNAME=
GEOSCENE_PORTAL_PASSWORD=
GEOSCENE_SERVER_URL=https://your-domain/server
GEOSCENE_SERVER_MANAGER_URL=https://your-domain/server/manager/home
GEOSCENE_SERVER_USERNAME=
GEOSCENE_SERVER_PASSWORD=
GEOSCENE_WEBSCENE_ID=
GEOSCENE_BUILDING_LAYER_URL=
GEOSCENE_EVENT_LAYER_URL=
GEOSCENE_ROUTE_MAPSERVER_URL=
GEOSCENE_ROUTE_NASERVER_URL=
GEOSCENE_ROAD_VISUAL_MAPSERVER_URL=
GEOSCENE_ROAD_VISUAL_LAYER_ID=0
GEOSCENE_ROAD_LAYER_ID=6
GEOSCENE_ROUTE_LAYER_NAME=路径
GEOSCENE_ROUTE_IMPEDANCE=SafeMinutes

# 本机 3D Tiles 建筑白模目录。没有数据时留空，前端会回退到 CSS 假地图。
WUHAN_3DTILES_DIR=
WUHAN_3DTILES_ROUTE=/tiles/wuhan

# 国内地图与公交服务
TIANDITU_KEY=
AMAP_KEY=
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# 演示用 JWT
JWT_SECRET=change-this-in-local-env
JWT_EXPIRE_MINUTES=10080

# 本地上传目录
UPLOAD_DIR=backend/uploads

# 前端如果通过 file:// 打开，Origin 可能是 null；建议演示时用 python -m http.server
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
